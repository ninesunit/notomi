# Public client configuration for the notomii deployment.
#
# Committed on purpose. Every value here is an EXPO_PUBLIC_* variable, which
# Expo inlines into the JavaScript bundle that every visitor to
# https://notomii.web.app already downloads — so this file publishes nothing
# that is not already public. It exists because the alternative was worse: with
# only a gitignored `.env`, a clean clone built an app with no configuration at
# all and every visitor landed on the "Finish setting up Notomi" screen.
#
# Nothing secret may be added below. Keys that authorize rather than identify —
# R2 signing credentials, service accounts — belong in the Worker or in
# `.env`, never in an EXPO_PUBLIC_* variable.
#
# Access control lives in firestore.rules; the API key is restricted by HTTP
# referrer in the Google Cloud console.

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDKRIGm43ggmTOfi5rQ5g_wCmg3n8Cu2xU
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=notomii.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=notomii
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=notomii.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=666272925159
EXPO_PUBLIC_FIREBASE_APP_ID=1:666272925159:web:5aaa9f88c6c338a3f3a942
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-FHRJYVYNGK
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.6-flash

# Live project, never the emulators — this file is only read by a production
# build.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=0

# The Worker holds the R2 signing key and hands out short-lived presigned URLs,
# so nothing secret ships in the bundle.
EXPO_PUBLIC_R2_BUCKET=notomi-materials
EXPO_PUBLIC_R2_WORKER_URL=https://notomi.filazliakim.workers.dev

# reCAPTCHA site keys are public by design; the secret half lives in
# the console.
EXPO_PUBLIC_APP_CHECK_SITE_KEY=6Lf4Yn4tAAAAALsTNex6Qh5Yl0oyLqqOzlzq7fTe

# How the web app is registered under App Check: 'v3' (default) or
# 'enterprise'. These are not interchangeable — offering an Enterprise
# token from an app registered for v3 is refused at the token exchange,
# which takes every AI feature down with an error that blames the AI.
EXPO_PUBLIC_APP_CHECK_PROVIDER=v3

# Public client identifiers for Drive. Neither grants access on its own — the
# student's own consent does, and only for files this app created.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=666272925159-qkidb4n2nv4a376qksdnt6vjk4dne6ih.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_API_KEY=AIzaSyDKRIGm43ggmTOfi5rQ5g_wCmg3n8Cu2xU
