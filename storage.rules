rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Notomi labels every upload with a canonical content type derived from
    // the parse that already succeeded on the device (see lib/parse.ts), so
    // this list can stay tight: the OS-reported type is never trusted.
    function isStudyMaterial() {
      return request.resource.contentType in [
        'application/pdf',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'text/plain'
      ];
    }

    // Originals live at materials/{userId}/{subjectId}/{documentId}-{fileName}.
    match /materials/{userId}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024
        && isStudyMaterial();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
