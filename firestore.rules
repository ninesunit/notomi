rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Whether the caller may see userId's shared week.
    //
    // Deliberately checks the document in *userId's* list, never the caller's.
    // A caller owns their own list and could mark anyone "accepted" there, so
    // reading their copy would let anyone grant themselves access. The copy
    // that matters is the one only userId can promote — and that userId can
    // delete at any moment to take the access back.
    function isAcceptedFriend(userId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid))
             .data.status == 'accepted';
    }

    function isAcceptedPair(memberIds) {
      return request.auth != null
        && memberIds is list
        && memberIds.size() == 2
        && request.auth.uid in memberIds
        && (
          (memberIds[0] == request.auth.uid && isAcceptedFriend(memberIds[1]))
          || (memberIds[1] == request.auth.uid && isAcceptedFriend(memberIds[0]))
        );
    }

    function validConversationMember(member) {
      return member is map
        && member.keys().hasOnly(['id', 'displayName', 'username', 'color'])
        && member.id is string
        && member.id.size() <= 128
        && member.displayName is string
        && member.displayName.size() <= 60
        && member.username is string
        && member.username.size() <= 24
        && member.color is string
        && member.color.size() <= 24;
    }

    function validMessageAttachment(attachment) {
      return attachment == null || (
        attachment is map
        && attachment.keys().hasOnly(['shareId', 'kind', 'title', 'subjectName'])
        && attachment.shareId is string
        && attachment.shareId.size() <= 128
        && attachment.kind in ['material', 'summary', 'flashcards']
        && attachment.title is string
        && attachment.title.size() <= 200
        && attachment.subjectName is string
        && attachment.subjectName.size() <= 200
      );
    }

    // Every Notomi document lives under users/{userId}, so ownership is the
    // only rule the app needs. Nothing is readable across accounts.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      // A temporary anonymous account owns its complete workspace. It may
      // remove the final profile anchor immediately before deleting its Auth
      // credential. Regular accounts cannot delete this document client-side.
      allow delete: if isOwner(userId) && resource.data.isAnonymous == true;

      match /semesters/{semesterId} {
        allow read, write: if isOwner(userId);
      }

      match /subjects/{subjectId} {
        allow read, write: if isOwner(userId);

        // Chat sessions and their messages are scoped to the owning subject.
        match /chats/{chatId} {
          allow read, write: if isOwner(userId);

          match /messages/{messageId} {
            allow read, delete: if isOwner(userId);
            allow create, update: if isOwner(userId)
              && request.resource.data.sender in ['user', 'ai']
              && request.resource.data.text is string
              && request.resource.data.text.size() < 100000;
          }
        }

        match /flashcards/{cardId} {
          allow read, delete: if isOwner(userId);
          allow create, update: if isOwner(userId)
            && request.resource.data.status in ['new', 'known', 'review']
            && request.resource.data.front is string
            && request.resource.data.front.size() > 0;
        }

        // One entry per class attended. Rules do not cascade into
        // subcollections, so this needs its own block even though the parent
        // subject already checks ownership.
        match /lectures/{lectureId} {
          allow read, delete: if isOwner(userId);
          allow create, update: if isOwner(userId)
            && request.resource.data.entry is string
            && request.resource.data.entry.size() > 0
            && request.resource.data.entry.size() <= 5000;
        }

        // Week-by-week teaching plan. Rules do not cascade, so this needs its
        // own block even though the parent subject already checks ownership.
        match /plan/{weekId} {
          allow read, delete: if isOwner(userId);
          allow create, update: if isOwner(userId)
            && request.resource.data.week is int
            && request.resource.data.week > 0
            && request.resource.data.week <= 60
            && request.resource.data.topic is string
            && request.resource.data.topic.size() > 0
            && request.resource.data.topic.size() <= 500;
        }

        match /assignments/{assignmentId} {
          allow read, delete: if isOwner(userId);
          allow create, update: if isOwner(userId)
            && request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 500
            && request.resource.data.kind in ['assignment', 'tutorial', 'lab', 'project']
            && request.resource.data.status in ['todo', 'in_progress', 'done'];
        }

        match /documents/{documentId} {
          allow read, delete: if isOwner(userId);
          // Source text is passed wholesale into the model's context window,
          // but a single document still has to fit under 1 MiB.
          allow create, update: if isOwner(userId)
            && request.resource.data.rawText is string
            && request.resource.data.rawText.size() < 900000;
        }
      }

      match /classes/{classId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.day is int
          && request.resource.data.day >= 0
          && request.resource.data.day <= 6
          && request.resource.data.startMinute is int
          && request.resource.data.endMinute is int
          && request.resource.data.startMinute < request.resource.data.endMinute;
      }

      // The non-academic overlay. Same shape rules as a class, but kept in its
      // own collection so academic queries never see it.
      match /routines/{routineId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.day is int
          && request.resource.data.day >= 0
          && request.resource.data.day <= 6
          && request.resource.data.startMinute is int
          && request.resource.data.endMinute is int
          && request.resource.data.startMinute < request.resource.data.endMinute;
      }

      match /sessions/{sessionId} {
        allow read, delete: if isOwner(userId);
        // Minutes are capped so a runaway timer cannot inflate a streak.
        allow create, update: if isOwner(userId)
          && request.resource.data.minutes is number
          && request.resource.data.minutes > 0
          && request.resource.data.minutes <= 600;
      }

      match /todos/{todoId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 500
          && request.resource.data.isCompleted is bool
          && request.resource.data.priority in ['low', 'medium', 'high'];
      }

      match /weak_concepts/{conceptId} {
        allow read, write: if isOwner(userId);
      }

      // Your friend list, and the one place another account may write.
      //
      // A request has two halves and no backend to write the second one, so the
      // sender writes both. The rules make that safe by allowing exactly one
      // shape of foreign write: a document that names the sender, marked
      // incoming. Everything else about your list stays yours.
      match /friends/{friendId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && friendId != userId;

        // Someone asking to be your friend.
        allow create: if request.auth != null
          && request.auth.uid == friendId
          && friendId != userId
          && request.resource.data.status == 'incoming'
          && request.resource.data.username is string
          && request.resource.data.username.size() <= 24
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 60;

        // Someone accepting a request *you* sent. Only the status may move, and
        // never out of 'incoming' — that is the state meaning "they asked you",
        // so refusing it is what stops anyone accepting their own request and
        // granting themselves a friendship. 'accepted' is allowed through as a
        // no-op so a repeated accept is not an error.
        allow update: if request.auth != null
          && request.auth.uid == friendId
          && resource.data.status != 'incoming'
          && request.resource.data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

        // Unfriending is symmetric: either side can break the pair.
        allow delete: if request.auth != null && request.auth.uid == friendId;
      }

      match /attendance_logs/{logId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.subjectId is string
          && request.resource.data.classId is string
          && request.resource.data.date is string
          && request.resource.data.status in ['present', 'absent', 'excused'];
      }

      // Read-only copies shared by accepted friends are filed directly in the
      // recipient's account. This avoids a global inbox query and keeps reads
      // under the same owner-scoped tree as the rest of the Library.
      match /shared_materials/{shareId} {
        allow read: if isOwner(userId);
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.recipientId == userId
          && isAcceptedFriend(userId)
          && request.resource.data.content is string
          && request.resource.data.content.size() < 900000;
        allow update: if false;
        // Either end may destroy a shared copy: the recipient because it is in
        // their Library, and the sender because sharing the wrong file is a
        // mistake that has to be undoable. The sender is named in the document
        // itself, so this grants nothing beyond what they already wrote.
        allow delete: if isOwner(userId)
          || (request.auth != null && request.auth.uid == resource.data.senderId);
      }

      // The sender's receipts — an id, a name and a title per share, and never
      // the content, which lives only in the recipient's copy.
      match /shares_sent/{shareId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.recipientId is string
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200;
        allow update: if false;
      }

      // Read receipts stay private. A conversation never writes into the
      // recipient's account merely because the sender opened it.
      match /conversation_reads/{conversationId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.lastReadAt is timestamp;
      }

      // Cross-account notifications contain summaries and ids only. The
      // sender must already be an accepted friend, and the recipient alone
      // controls read state and decisions after delivery.
      match /social_inbox/{itemId} {
        allow read, delete: if isOwner(userId);
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.recipientId == userId
          && isAcceptedFriend(userId)
          && request.resource.data.type in ['availability', 'share', 'sprint', 'circle']
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 160
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 600
          && request.resource.data.payload is map
          && request.resource.data.payload.keys().hasOnly(['shareId', 'kind', 'subjectName', 'slots', 'participantIds', 'sprintId'])
          && (!('slots' in request.resource.data.payload)
            || (request.resource.data.payload.slots is list
              && request.resource.data.payload.slots.size() <= 3))
          && (!('participantIds' in request.resource.data.payload)
            || (request.resource.data.payload.participantIds is list
              && request.resource.data.payload.participantIds.size() <= 4))
          && (!('shareId' in request.resource.data.payload)
            || (request.resource.data.payload.shareId is string
              && request.resource.data.payload.shareId.size() <= 128))
          && (!('sprintId' in request.resource.data.payload)
            || (request.resource.data.payload.sprintId is string
              && request.resource.data.payload.sprintId.size() <= 128))
          && request.resource.data.status == 'new';
        allow update: if isOwner(userId)
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.recipientId == resource.data.recipientId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'readAt'])
          && request.resource.data.status in ['new', 'accepted', 'declined'];
      }

      // Who this student has blocked, and why if they said. Private to them:
      // filed under the blocker so blocking needs no permission on anything
      // the blocked account can read, and leaves them nothing to look up.
      match /blocked/{blockedId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && blockedId != userId
          && (request.resource.data.reason == null
            || (request.resource.data.reason is string
              && request.resource.data.reason.size() <= 500));
        allow update: if false;
      }

      // Cached micro-learning cards and their private SRS interaction state.
      // Discovery content never becomes public merely because Gemini wrote it.
      match /reelCards/{cardId} {
        allow read, write: if isOwner(userId);
      }

      match /reel_cards/{cardId} {
        allow read, write: if isOwner(userId);
      }

      // A canvas is stored as one compressed JSON string after a three-second
      // idle window. Binary PDF/image previews stay in IndexedDB or R2, never
      // inside Firestore's one-megabyte document envelope.
      match /note_canvases/{canvasId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.payload is string
          && request.resource.data.payload.size() < 850000
          && request.resource.data.nodeCount is int
          && request.resource.data.nodeCount >= 0
          && request.resource.data.version == 1;
      }

      // Notebook metadata is separate from compressed page payloads so adding
      // a page never rewrites every stroke in the notebook. Every path stays
      // below the authenticated owner's user tree.
      match /note_notebooks/{notebookId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && (request.resource.data.subjectId == null || request.resource.data.subjectId is string)
          && request.resource.data.color is string
          && request.resource.data.pages is list
          && request.resource.data.pages.size() >= 1
          && request.resource.data.pages.size() <= 50
          && request.resource.data.version == 1;

        match /pages/{pageId} {
          allow read, delete: if isOwner(userId);
          allow create, update: if isOwner(userId)
            && request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 120
            && request.resource.data.payload is string
            && request.resource.data.payload.size() < 850000
            && request.resource.data.nodeCount is int
            && request.resource.data.nodeCount >= 0
            && request.resource.data.nodeCount <= 5000
            && request.resource.data.version == 1;
        }
      }
    }

    // Direct messages are limited to one accepted friend pair. A message can
    // point at a read-only shared copy, never at the sender's private source.
    match /conversations/{conversationId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow create: if isAcceptedPair(request.resource.data.memberIds)
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && validConversationMember(request.resource.data.members[0])
        && validConversationMember(request.resource.data.members[1])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 200
        && request.resource.data.lastSenderId == request.auth.uid;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && isAcceptedPair(resource.data.memberIds)
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && validConversationMember(request.resource.data.members[0])
        && validConversationMember(request.resource.data.members[1])
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 200
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'lastMessage', 'lastSenderId', 'lastMessageAt', 'createdAt', 'updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds
          && isAcceptedPair(getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && validMessageAttachment(request.resource.data.attachment);
        allow update, delete: if false;
      }
    }

    // Course circles are opt-in and deterministic: one bounded group for one
    // university and course code. Public course sharing is the join gate.
    match /circles/{circleId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.courseCode is string
        && request.resource.data.courseCode.size() <= 30
        && request.resource.data.universityId is string
        && request.resource.data.universityId.size() <= 160
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.shareCourses == true
        && request.resource.data.courseCode in get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.courseCodes
        && request.resource.data.universityId == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.universityId;
      allow update: if request.auth != null && (
        (
          request.auth.uid in resource.data.memberIds
          && request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
        )
        || (
          !(request.auth.uid in resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.size() <= 20
          && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).hasOnly([request.auth.uid])
          && resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()).size() == 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
          && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.shareCourses == true
          && resource.data.courseCode in get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.courseCodes
          && resource.data.universityId == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.universityId
        )
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      match /posts/{postId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 60
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1500
          && validMessageAttachment(request.resource.data.attachment);
        allow update, delete: if false;
      }
    }

    // The only cross-account lookup in the app: a username and public profile.
    match /profiles/{userId} {
      allow get: if request.auth != null;
      // Capped so the directory can be searched but not harvested in bulk.
      allow list: if request.auth != null && request.query.limit <= 12;

      allow create, update: if isOwner(userId)
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24
        && request.resource.data.username.matches('^[a-z0-9._-]+$')
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 280
        && request.resource.data.major is string
          && request.resource.data.major.size() <= 100
          && request.resource.data.university is string
          && request.resource.data.university.size() <= 100
          && (!('universityId' in request.resource.data)
            || (request.resource.data.universityId is string
              && request.resource.data.universityId.size() <= 160))
          && (!('universityAbbreviation' in request.resource.data)
            || (request.resource.data.universityAbbreviation is string
              && request.resource.data.universityAbbreviation.size() <= 12))
          && (!('avatarIcon' in request.resource.data)
            || request.resource.data.avatarIcon == null
            || (request.resource.data.avatarIcon is string
              && request.resource.data.avatarIcon.size() <= 40))
          && (!('avatarKey' in request.resource.data)
            || (request.resource.data.avatarKey is string
              && request.resource.data.avatarKey.size() <= 220
              && (request.resource.data.avatarKey == ''
                || request.resource.data.avatarKey.matches('^users/' + userId + '/profile/[A-Za-z0-9._-]+$'))))
          && (!('courseCodes' in request.resource.data)
            || (request.resource.data.courseCodes is list
              && request.resource.data.courseCodes.size() <= 30))
          && (!('searchPrefixes' in request.resource.data)
            || (request.resource.data.searchPrefixes is list
              && request.resource.data.searchPrefixes.size() <= 120))
          && (!('shareCourses' in request.resource.data)
            || request.resource.data.shareCourses is bool)
          && (!('sharePresence' in request.resource.data)
            || request.resource.data.sharePresence is bool)
          && (!('shareSchedule' in request.resource.data)
            || request.resource.data.shareSchedule is bool);
      allow delete: if isOwner(userId);
    }

    // A week reduced to when you are busy — day, start, end, and nothing else.
    // Readable only by someone you have accepted.
    match /busy/{userId} {
      allow read: if isOwner(userId)
        || (isAcceptedFriend(userId)
          && get(/databases/$(database)/documents/profiles/$(userId)).data.shareSchedule == true
          && resource.data.keys().hasOnly(['intervals', 'updatedAt']));
      allow create, update: if isOwner(userId)
        && get(/databases/$(database)/documents/profiles/$(userId)).data.shareSchedule == true
        && request.resource.data.keys().hasOnly(['intervals', 'updatedAt'])
        && request.resource.data.intervals is list
        && request.resource.data.intervals.size() <= 300
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    // Live focus status. Expires by its own `until`, so a stale document says
    // nothing rather than lying.
      match /presence/{userId} {
        allow read: if isOwner(userId) || isAcceptedFriend(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.status in ['focus', 'class', 'reel', 'idle'];
      allow delete: if isOwner(userId);
    }

    match /discoveryCards/{cardId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Arena uses Firestore listeners as its real-time room channel. A lobby is
    // discoverable only to signed-in students; after start, only members can
    // read the cached deck and scoreboard.
    match /arena_rooms/{roomId} {
      allow read: if request.auth != null
        && (resource.data.status == 'lobby' || request.auth.uid in resource.data.memberIds);
      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.status in ['lobby', 'playing'];
      allow update: if request.auth != null && (
        (
          request.auth.uid == resource.data.hostId
          && request.resource.data.hostId == resource.data.hostId
          && request.resource.data.memberIds == resource.data.memberIds
          && (request.resource.data.status != 'playing'
            || resource.data.status == 'playing'
            || request.resource.data.memberIds.size() >= 2)
        )
        || (
          resource.data.status == 'lobby'
          && isAcceptedFriend(resource.data.hostId)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.size() <= 6
          && request.resource.data.memberIds.toSet()
               .difference(resource.data.memberIds.toSet()).hasOnly([request.auth.uid])
          && resource.data.memberIds.toSet()
               .difference(request.resource.data.memberIds.toSet()).size() == 0
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['memberIds', 'updatedAt'])
        )
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.hostId;

      match /players/{playerId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/arena_rooms/$(roomId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid == playerId
          && request.auth.uid in getAfter(/databases/$(database)/documents/arena_rooms/$(roomId)).data.memberIds
          && (request.auth.uid == getAfter(/databases/$(database)/documents/arena_rooms/$(roomId)).data.hostId
            || isAcceptedFriend(getAfter(/databases/$(database)/documents/arena_rooms/$(roomId)).data.hostId));
        allow update: if request.auth != null
          && request.auth.uid == playerId
          && request.auth.uid in get(/databases/$(database)/documents/arena_rooms/$(roomId)).data.memberIds;
        allow delete: if request.auth != null
          && (request.auth.uid == playerId
            || request.auth.uid == get(/databases/$(database)/documents/arena_rooms/$(roomId)).data.hostId);
      }

      match /decks/{playerId} {
        allow read, update: if request.auth != null
          && request.auth.uid == playerId
          && request.auth.uid in get(/databases/$(database)/documents/arena_rooms/$(roomId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid == playerId
          && request.auth.uid in getAfter(/databases/$(database)/documents/arena_rooms/$(roomId)).data.memberIds
          && (request.auth.uid == getAfter(/databases/$(database)/documents/arena_rooms/$(roomId)).data.hostId
            || isAcceptedFriend(getAfter(/databases/$(database)/documents/arena_rooms/$(roomId)).data.hostId));
        allow delete: if request.auth != null
          && (request.auth.uid == playerId
            || request.auth.uid == get(/databases/$(database)/documents/arena_rooms/$(roomId)).data.hostId);
      }
    }

    // Saved runs are visible only to their owner and accepted friends.
    match /arena_ghosts/{ghostId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.ownerId || isAcceptedFriend(resource.data.ownerId));
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
    }

    // Project members share one live task plan. Membership is immutable after
    // creation so a member cannot grant a third party access.
    match /sprints/{sprintId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 12;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // A share is a read-only snapshot, not access to the sender's Subject tree.
    match /material_shares/{shareId} {
      allow get: if request.auth != null
        && (request.auth.uid == resource.data.senderId
          || request.auth.uid == resource.data.recipientId);
      // Inbox queries constrain recipientId to the signed-in account. Keeping
      // this as a direct equality lets Firestore prove the query is safe.
      allow list: if request.auth != null
        && resource.data.recipientId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid
        && isAcceptedFriend(request.resource.data.recipientId)
        && request.resource.data.content is string
        && request.resource.data.content.size() < 900000;
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid in [resource.data.senderId, resource.data.recipientId];
    }

    // Deny anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
