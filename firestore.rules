rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Every Notomi document lives under users/{userId}, so ownership is the
    // only rule the app needs. Nothing is readable across accounts.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;

      match /semesters/{semesterId} {
        allow read, write: if isOwner(userId);
      }

      match /subjects/{subjectId} {
        allow read, write: if isOwner(userId);

        // Chat sessions and their messages are scoped to the owning subject.
        match /chats/{chatId} {
          allow read, write: if isOwner(userId);

          match /messages/{messageId} {
            allow read, delete: if isOwner(userId);
            allow create, update: if isOwner(userId)
              && request.resource.data.sender in ['user', 'ai']
              && request.resource.data.text is string
              && request.resource.data.text.size() < 100000;
          }
        }

        match /flashcards/{cardId} {
          allow read, delete: if isOwner(userId);
          allow create, update: if isOwner(userId)
            && request.resource.data.status in ['new', 'known', 'review']
            && request.resource.data.front is string
            && request.resource.data.front.size() > 0;
        }

        match /documents/{documentId} {
          allow read, delete: if isOwner(userId);
          // Source text is passed wholesale into Gemini's context window, but a
          // single Firestore document still has to fit under 1 MiB.
          allow create, update: if isOwner(userId)
            && request.resource.data.rawText is string
            && request.resource.data.rawText.size() < 900000;
        }
      }

      match /classes/{classId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.day is int
          && request.resource.data.day >= 0
          && request.resource.data.day <= 6
          && request.resource.data.startMinute is int
          && request.resource.data.endMinute is int
          && request.resource.data.startMinute < request.resource.data.endMinute;
      }

      match /sessions/{sessionId} {
        allow read, delete: if isOwner(userId);
        // Minutes are capped so a runaway timer cannot inflate a streak.
        allow create, update: if isOwner(userId)
          && request.resource.data.minutes is number
          && request.resource.data.minutes > 0
          && request.resource.data.minutes <= 600;
      }

      match /todos/{todoId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 500
          && request.resource.data.isCompleted is bool
          && request.resource.data.priority in ['low', 'medium', 'high'];
      }

      match /weak_concepts/{conceptId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
