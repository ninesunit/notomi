# Firebase web app config — Firebase Console > Project settings > General >
# "Your apps" > Web app > SDK setup and configuration > Config.
#
# Copy this file to `.env` and fill in the values from project `notomii`.
# These EXPO_PUBLIC_* values are inlined into the client bundle. That is
# expected and safe for Firebase web config: they identify the project, they
# do not authorize anything. Access control lives in firestore.rules /
# storage.rules, and the API key should be restricted by HTTP referrer in the
# Google Cloud console.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=notomii.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=notomii
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=notomii.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional. Gemini model served through Firebase AI Logic.
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.6-flash

# Local development against `npx firebase emulators:start`.
# Set to 1 to route Auth/Firestore/Storage at localhost instead of the live
# project. Gemini (AI Logic) always calls the real service.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=0

# ---------------------------------------------------------------------------
# Cloudflare R2 (original study materials)
# ---------------------------------------------------------------------------
# RECOMMENDED: point the app at the Worker in worker/, which holds the R2
# signing key and hands out short-lived presigned URLs. Nothing secret ships in
# the bundle.
EXPO_PUBLIC_R2_WORKER_URL=https://notomi-r2.filazliakim.workers.dev
EXPO_PUBLIC_R2_BUCKET=notomi-materials

# Optional: public bucket base (r2.dev URL or custom domain). When set, view
# links use it directly instead of presigning.
EXPO_PUBLIC_R2_PUBLIC_URL=

# LOCAL DEVELOPMENT ONLY. These sign requests in the client, so they are
# refused in a production web build — Expo inlines EXPO_PUBLIC_* into the
# bundle every visitor downloads, which would publish your bucket credentials.
EXPO_PUBLIC_R2_ACCOUNT_ID=
EXPO_PUBLIC_R2_ACCESS_KEY_ID=
EXPO_PUBLIC_R2_SECRET_ACCESS_KEY=

# Optional. Analytics measurement id from the Firebase web config.
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-FHRJYVYNGK

# Optional. App Check reCAPTCHA Enterprise SCORE site key — Firebase console > App Check >
# Apps > Web. App Check stays OFF until this is set: initializing it without a
# registered site key makes every attested request fail, which would take the
# app down rather than harden it.
EXPO_PUBLIC_APP_CHECK_SITE_KEY=

# How the web app is registered under App Check: 'v3' (default) or
# 'enterprise'. These are not interchangeable — offering an Enterprise
# token from an app registered for v3 is refused at the token exchange,
# which takes every AI feature down with an error that blames the AI.
EXPO_PUBLIC_APP_CHECK_PROVIDER=v3

# ---------------------------------------------------------------------------
# Google Drive (student file storage)
# ---------------------------------------------------------------------------
# Files go from the browser straight into the student's own Drive, so Notomi
# pays for no storage and no bandwidth. Both values below are public client
# identifiers, the same class as the Firebase config above — neither grants
# access on its own.
#
# CLIENT_ID: the OAuth web client Firebase Auth already created for Google
# sign-in. Firebase console > Authentication > Sign-in method > Google > Web
# SDK configuration. Its authorised JavaScript origins must include your
# hosting domain and http://localhost:8081.
#
# API_KEY: a browser API key, used only as the Google Picker's developer key.
# The Firebase API key works if the Picker API is enabled and the key is not
# restricted away from it.
#
# Leave both blank and every Drive entry point stays hidden; uploads fall back
# to R2 exactly as before.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_API_KEY=

# Optional. The GCP project number, which the Picker needs to grant a
# drive.file app access to a chosen file. Defaults to the Firebase messaging
# sender id, which is the same number, so this is normally left blank.
EXPO_PUBLIC_GOOGLE_APP_ID=
