{
  "name": "notomi",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.8",
    "expo": "~57.0.11",
    "expo-asset": "~57.0.9",
    "expo-constants": "~57.0.9",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-speech": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.17.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react-native": "^1.31.0",
    "lz-string": "^1.5.0",
    "mammoth": "^1.12.1",
    "nativewind": "^4.2.6",
    "pdfjs-dist": "^6.2.108",
    "perfect-freehand": "^1.2.3",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.10.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node scripts/copy-pdf-worker.mjs && expo start",
    "web": "node scripts/copy-pdf-worker.mjs && expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build:web": "node scripts/copy-pdf-worker.mjs && expo export --platform web --clear && node scripts/patch-html.mjs",
    "typecheck": "tsc --noEmit",
    "test:budget": "node --experimental-strip-types --no-warnings scripts/budget.test.mjs",
    "deploy:hosting": "npm run build:web && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "icons": "python3 scripts/make-icons.py"
  },
  "private": true
}
