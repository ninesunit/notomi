{
  "expo": {
    "name": "Notomi",
    "slug": "notomi",
    "version": "1.0.0",
    "scheme": "notomi",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.notomi.app"
    },
    "android": {
      "package": "com.notomi.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F5EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Notomi",
      "shortName": "Notomi",
      "themeColor": "#F7F5EE",
      "backgroundColor": "#F7F5EE",
      "display": "standalone",
      "orientation": "any"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "description": "Upload your lectures, ask questions grounded in your own sources, and let your syllabus fill in your to-do list.",
    "primaryColor": "#B4552D",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5EE"
    }
  }
}
